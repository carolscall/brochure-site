---
import '../styles/global.css';
import { site, nav } from '../site.config';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}: ${site.tagline}`;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1b5c4b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${site.name} home`}><Logo />{site.name}</a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
          <a href={site.signInUrl}>Sign in</a>
          <a class="btn small" href={site.signupUrl}>Get started</a>
        </nav>
        <details class="menu">
          <summary aria-label="Menu">Menu</summary>
          <div class="menu-panel">
            {nav.map((n) => <a href={n.href}>{n.label}</a>)}
            <a href={site.signInUrl}>Sign in</a>
            <a class="btn" href={site.signupUrl}>Get started</a>
          </div>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div>
            <a class="brand" href="/"><Logo />{site.name}</a>
            <p class="muted" style="margin-top:12px">{site.tagline}</p>
          </div>
          <div>
            <h4>Product</h4>
            <ul>
              <li><a href="/families/">For families</a></li>
              <li><a href="/organizations/">For care providers</a></li>
              <li><a href="/partners/">Partners</a></li>
              <li><a href="/pricing/">Pricing</a></li>
            </ul>
          </div>
          <div>
            <h4>Help</h4>
            <ul>
              <li><a href="/faq/">FAQ</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href={site.signInUrl}>Sign in</a></li>
            </ul>
          </div>
          <div>
            <h4>Legal</h4>
            <ul>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms</a></li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <p>
            {site.name} is a friendly check-in service, not a medical alert, monitoring or emergency service, and it
            does not give medical advice. In an emergency, call 911.
          </p>
          <p>© {year} {site.companyLine || site.name}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
