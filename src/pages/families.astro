---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PlanCards from '../components/PlanCards.astro';
import Cta from '../components/Cta.astro';
import { householdDiscountPct } from '../data/pricing';
import { site } from '../site.config';
---
<Base title="For families" description={`Friendly check-in phone calls for your parent or grandparent, with text and email alerts when they need something. From $19 a month.`}>
  <section class="hero">
    <div class="wrap" style="grid-template-columns:1fr">
      <div>
        <span class="kicker">For families</span>
        <h1>Someone checks in, even on the days you can't.</h1>
        <p class="lead">
          You love them and you worry. {site.name} gives them a friendly call on a regular schedule, and gives you a
          short note after each one, plus an alert if something's wrong.
        </p>
        <div class="actions">
          <a class="btn" href={`${site.signupUrl}?plan=plus`}>Enroll a loved one</a>
          <a class="btn ghost" href="#plans">Compare plans</a>
        </div>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap grid three">
      <div class="card">
        <Icon name="chat" />
        <h3>What we talk about</h3>
        <p>How they're feeling, sleeping and eating. Whether they need groceries, a ride or help with an errand. Then their day, the weather, their interests.</p>
      </div>
      <div class="card">
        <Icon name="note" />
        <h3>You shape every call</h3>
        <p>Add notes like "hard of hearing, speak slowly" or "don't bring up her late husband". On Plus and Premium we can ask about the people they love by name.</p>
      </div>
      <div class="card">
        <Icon name="bell" />
        <h3>Alerts you choose</h3>
        <p>Text or email, to you and anyone else you add, when they mention a need, ask to talk to a person, or miss calls in a row.</p>
      </div>
    </div>
  </section>

  <section id="plans">
    <div class="wrap">
      <div class="center">
        <h2>Plans</h2>
        <p class="lead">Month to month. Change plans or cancel any time.</p>
      </div>
      <div style="margin-top:48px"><PlanCards /></div>
      <p class="center" style="margin-top:28px">
        <strong>Two people in one home?</strong> Each additional person is {householdDiscountPct}% off.
      </p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap grid two">
      <div>
        <h2>Getting started takes about five minutes</h2>
        <ul class="checks">
          <li>Choose a plan and tell us their name and phone number.</li>
          <li>Confirm that they've agreed to receive the calls. We only call people who want us to.</li>
          <li>Set your password, then add notes, family contacts and who gets alerts.</li>
          <li>Calls begin once your enrollment is confirmed.</li>
        </ul>
        <div class="actions"><a class="btn" href={site.signupUrl}>Start enrollment</a></div>
      </div>
      <div class="card">
        <h3>Let them know we'll be calling</h3>
        <p>
          Calls come from a regular phone number and start with a friendly introduction. {site.name} uses an automated
          voice, and it says so if asked. It never asks for money, account numbers or passwords.
        </p>
        <p class="muted">Tip: save our number in their phone as "{site.name} check-in" so they know who it is.</p>
      </div>
    </div>
  </section>

  <Cta />
</Base>
